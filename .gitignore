# Binaries (anchored to repo root so cmd/punchcard/ source is NOT ignored)
/bin/
/punchcard

# Local environment (never commit real secrets; only .env.example is tracked)
.env
deploy/.env

# Go
*.test
*.out
coverage.*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Session scratch (deploy script, verification screenshots/scripts)
/scratchpad/

# Browser-automation scratch.
/.playwright-mcp/

# Swift build output (apps/menubar)
apps/menubar/.build/
apps/menubar/build/

# Web app build inputs. The BUILT dist is committed (internal/http/webui/dist)
# because go build and Docker run no Node stage.
/web/node_modules/
