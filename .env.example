# punchcard configuration (12-factor: environment variables only).
# Copy to .env for local development: `cp .env.example .env`.
# The binary does NOT read this file; `make run` sources ./.env, and
# docker-compose sources deploy/.env.
#
# This file lists every variable internal/config reads. Anything absent here
# is a bug in this file, not a variable the server ignores.

# --- Required ---
# PostgreSQL connection (URL or DSN form). The only required variable.
DATABASE_URL=postgres://agenttodo:agenttodo@localhost:5432/agenttodo?sslmode=disable

# --- Server ---
# development | production. Gates log defaults and (later) webhook HTTP policy.
APP_ENV=development
# Server secret used to derive the CSRF token (and other non-storage HMACs).
# Set to a long random string in production so the token is stable across
# restarts; if empty a per-process random value is used. e.g. `openssl rand -hex 32`
APP_SECRET=
# Listen address for the plain-HTTP server (TLS is terminated by Caddy).
HTTP_ADDR=:8080
# Externally reachable base URL (no trailing slash). Used for links in emails.
PUBLIC_BASE_URL=http://localhost:8080
# Path where Prometheus metrics are exposed on the main mux.
METRICS_PATH=/metrics
# When set, scrapers must send this as a bearer token to read METRICS_PATH.
# Leaving it empty leaves the endpoint OPEN — fine on a trusted network, but
# on a public host it exposes per-endpoint traffic and error counts.
METRICS_TOKEN=
# Comma-separated CIDRs whose X-Forwarded-For header is trusted. Empty falls
# back to loopback + private + CGNAT ranges. Set this when running behind a
# reverse proxy on a public address: otherwise every request appears to come
# from the proxy, so per-IP auth rate limiting shares one bucket across all
# users. A public client can never spoof its way past this.
TRUSTED_PROXIES=
# debug | info | warn | error
LOG_LEVEL=info
# Graceful shutdown drain timeout.
SHUTDOWN_TIMEOUT=20s

# --- Database / migrations ---
# Apply pending migrations at `serve` startup (under an advisory lock).
# Set false when migrations are run out-of-band by ops.
AUTO_MIGRATE=true
# Max connections in the pgx pool.
DB_MAX_CONNS=10

# --- CORS ---
# Comma-separated exact allow-list of browser origins. Leave empty in dev.
# Must be set in production once the web UI is served (Phase 6).
CORS_ALLOWED_ORIGINS=

# --- Email (Section 6) ---
# dev = log messages (verification/reset links visible in logs outside prod);
# smtp = deliver via SMTP.
EMAIL_PROVIDER=dev
EMAIL_FROM=punchcard <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Social login (all optional; a provider's button only appears once both
#     its id and secret are set) ---
# Redirect URIs are NOT configured here. They are derived as
# {PUBLIC_BASE_URL}/v1/auth/oauth/{provider}/callback, so the provider app must
# be registered with exactly that callback or the flow fails at the redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Seals stored GitHub access tokens (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
# Unset means the GitHub integration stays off; there is no plaintext fallback.
GITHUB_TOKEN_KEY=
# Sign in with Apple has no static secret: the client secret is a JWT signed
# per request with the .p8 key. APPLE_CLIENT_ID is the **Services ID**, not the
# app's bundle identifier. APPLE_PRIVATE_KEY is the PKCS#8 PEM body of the .p8
# the developer portal lets you download exactly once.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Assistant (optional) ---
# Without an API key the prompt bar is disabled; the rest of the app is
# unaffected. The key is process-wide, not per user.
# Overrides the default model. See gemini.DefaultModel for why that default is
# what it is.

# --- Rate limiting (Section 14) ---
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=5

# --- Webhooks (Section 10) ---
# Base64-encoded 32-byte AES key encrypting webhook signing secrets at rest,
# e.g. `openssl rand -base64 32`. If empty, webhook creation is DISABLED —
# which is the failure mode to check first when /v1/webhooks rejects a create.
WEBHOOK_ENCRYPTION_KEY=
# Permit plain-http webhook targets. Self-host only; leave false on a public
# instance so secrets are never sent in the clear.
WEBHOOK_ALLOW_HTTP=false
# Global cap on concurrent outbound deliveries (egress control).
WEBHOOK_MAX_CONCURRENCY=8
# Disable a webhook after this many consecutive dead deliveries.
WEBHOOK_AUTO_DISABLE_THRESHOLD=20
# How often the dispatcher drains the outbox and attempts due deliveries.
WEBHOOK_POLL_INTERVAL=2s

# --- SSE (Section 12) ---
# Per-user cap on concurrent live-update streams.
SSE_MAX_CONN_PER_USER=10
# How often the stream polls the events table. This is a deliberate deviation
# from LISTEN/NOTIFY with the same delivery and resume semantics.
SSE_POLL_INTERVAL=1s

# --- Offline sync (docs/offline-sync.md) ---
# Freshness guard on the seq-cursor reads (GET /v1/changes, SSE): events
# younger than this are not served yet, so out-of-order commits can't be
# skipped by a forward-only cursor.
EVENT_GRACE_WINDOW=1s
# How often retention jobs run (purge soft-deleted tasks >30d, events >30d,
# idempotency keys >24h). 0 disables.
JANITOR_INTERVAL=1h

# --- Quotas (Section 14) ---
MAX_PATS_PER_USER=25
MAX_PROJECTS_PER_USER=500
MAX_WEBHOOKS_PER_USER=10

# How often the GitHub commit queue is drained, and how often the last seven
# days of sessions go back on it (which catches commits pushed hours late).
SCAN_INTERVAL=1m
SCAN_REQUEUE_INTERVAL=1h
