# docker-compose environment. Copy to deploy/.env and edit before deploying:
#   cp deploy/.env.example deploy/.env

# Public hostname for automatic HTTPS via Caddy (e.g. todo.example.com).
# Use ":80" for local HTTP-only testing.
DOMAIN=:80
PUBLIC_BASE_URL=http://localhost

# Postgres credentials. REQUIRED: replace the password with a strong secret.
POSTGRES_USER=agenttodo
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=agenttodo

# App
APP_ENV=production
LOG_LEVEL=info
APP_VERSION=dev

# Cross-origin API callers (comma-separated). The Tauri desktop/mobile app's
# webview needs its origin listed so its bearer-token fetches are allowed.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost

# Reverse-proxy CIDRs whose forwarded client-IP headers are trusted. Empty
# defaults to loopback + private + CGNAT ranges (fine behind Caddy/Cloudflare
# on a private network). Set explicitly to tighten. e.g. TRUSTED_PROXIES=192.168.8.0/24
# TRUSTED_PROXIES=

# Protect /metrics with a bearer token (empty = open on trusted networks).
# METRICS_TOKEN=

# --- Social login (optional) ---
# Each provider turns on only when BOTH its id and secret are set. Register the
# app with this exact callback (derived from PUBLIC_BASE_URL):
#   Google: {PUBLIC_BASE_URL}/v1/auth/oauth/google/callback
#   GitHub: {PUBLIC_BASE_URL}/v1/auth/oauth/github/callback
# Google:  https://console.cloud.google.com/apis/credentials  (OAuth client, type "Web application")
# GitHub:  https://github.com/settings/developers  (New OAuth App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Apple. APPLE_CLIENT_ID is the *Services ID*, not the bundle id.
# APPLE_PRIVATE_KEY is the contents of the .p8 the developer portal downloads
# once — the whole PEM including the BEGIN/END lines; \n escapes are accepted.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
